# ---------- Base de datos ----------
# La MISMA base de datos que el backend Spring Boot (backend/src/main/resources/application.yml).
# Si la base de datos no existe, `python -m app.data.seed` la crea.
# Para probar solo la IA sin PostgreSQL, deja la línea vacía -> SQLite local en data/compras.db
DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/mercadona_db

# ---------- LLM ----------
# Orden de prioridad. Se salta los que no estén disponibles. "mock" = respuestas sin IA (la demo nunca se cae)
LLM_PROVIDERS=ollama,gemini,groq,mock
LLM_MODE=live
LLM_TIMEOUT=120

# Local: instala Ollama y ejecuta `ollama pull qwen2.5:7b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192

# APIs gratuitas de respaldo (para quien pruebe el proyecto sin Ollama). Basta con una.
# Gemini: clave gratis en https://aistudio.google.com  |  Groq: clave gratis en https://console.groq.com
# Ojo: en los planes gratuitos el proveedor puede usar los datos -> solo datos sintéticos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fecha "de hoy" fija para la demo (YYYY-MM-DD). Vacío = fecha real.
DEMO_HOY=
